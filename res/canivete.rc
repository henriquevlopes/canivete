#include <winres.h>
#include "resource.h"

IDI_APP ICON "canivete.ico"
IDI_TRAY_DARK ICON "tray_dark.ico"
IDI_TRAY_LIGHT ICON "tray_light.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Canivete"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Canivete"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "Canivete.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
